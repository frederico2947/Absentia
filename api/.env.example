# Copy this file to .env and fill in your values
# The API reads these at startup.

# Port the NestJS API listens on (default: 3000)
PORT=3000

# Allowed CORS origin (Angular dev server or production URL)
CORS_ORIGIN=http://localhost:4200

# SQLite database file path (relative to the api/ directory)
DB_PATH=absentia.db

# JWT signing secret — CHANGE THIS in production!
ABSENTIA_JWT_SECRET=change-me-in-production
